# Rain 启动配置（业务资源限制请在管理员“系统设置”中维护）
DATABASE_URL=sqlite://./data/rain.db
RAIN_DATA_ROOT=./data/uploads
RAIN_LOG_DIR=./log
SERVER_HOST=0.0.0.0
SERVER_PORT=8078
# 仅本地开发使用；生产环境不要设置为 true。
RESET_DB=false

# 首次安装管理员；已有管理员不会被这些变量重置。
RAIN_BOOTSTRAP_ADMIN_USERNAME=admin
RAIN_BOOTSTRAP_ADMIN_PASSWORD=

# 默认搜索后端为 Tantivy，索引单行上限为 256 KiB。
# 这两个值通常无需写入 ENV；高级兼容入口仍由程序保留。

# 旧业务配置变量（RAIN_ISSUE_MAX_CONTENT_SIZE、RAIN_ALLOW_REGISTRATION 等）
# 只会在对应数据库字段尚未初始化时导入一次；已有数据库值始终优先。
