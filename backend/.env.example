# SQLite 数据库地址；相对路径以程序启动目录为基准。
DATABASE_URL=sqlite://./data/rain.db
# 上传文件、解压结果和临时处理目录的根路径。
RAIN_DATA_ROOT=./data/uploads
# 后端运行日志的保存目录。
RAIN_LOG_DIR=./log
# 后端监听地址；0.0.0.0 表示监听所有网络接口。
SERVER_HOST=0.0.0.0
# 后端监听端口。
SERVER_PORT=8080
# 是否在启动时重建数据库并清空上传目录；仅建议本地开发时使用。
RESET_DB=false
# 上传数据的自动保留天数；设置为 0 或留空表示不自动清理。
RAIN_RETENTION_DAYS=0
# Issue 非活跃自动过期天数；0 关闭，启用范围为 7–30。
RAIN_ISSUE_INACTIVE_DAYS=0

# 用户认证
# 是否允许新用户注册；关闭后已有用户仍可登录。
RAIN_ALLOW_REGISTRATION=true
# 登录 Session 的有效期（秒），必须大于 0；默认 7 天。
RAIN_SESSION_TTL_SECONDS=604800
# Argon2 哈希/校验并发上限；满载时认证请求返回 429。
RAIN_AUTH_ARGON2_CONCURRENCY=5
# 每个 IP 的登录尝试上限，60 秒窗口。
RAIN_AUTH_LOGIN_IP_LIMIT_PER_MINUTE=20
# 每个用户名的失败登录上限，5 分钟窗口；成功登录不计入。
RAIN_AUTH_LOGIN_USERNAME_FAILURE_LIMIT_PER_5_MINUTES=10
# 每个 IP 的注册尝试上限，1 小时窗口。
RAIN_AUTH_REGISTER_IP_LIMIT_PER_HOUR=10

# Issue 内容容量
# 每个 Issue 最终可浏览文件的总大小；压缩包按解压后的最终文件计算。
RAIN_ISSUE_MAX_CONTENT_SIZE=4GiB

# 后台处理
# 同时进行解压和索引的后台任务数量，必须大于 0。
RAIN_UPLOAD_CONCURRENT_PROCESSING_TASKS=4
# 同时接收 Multipart 上传请求的数量，必须大于 0。
RAIN_UPLOAD_CONCURRENT_RECEIVE_TASKS=4
# 所有上传接收临时目录的全局字节上限。
RAIN_UPLOAD_MAX_TMP_BYTES=16GiB

# 日志索引限制
# 单行日志进入搜索索引的最大前缀字节数；超出部分会截断并标记。
RAIN_INDEXING_MAX_INDEXED_LINE_SIZE=256KiB

# API 响应限制
# 文件内容预览最多读取的字节数；支持二进制大小单位。
RAIN_API_FILE_PREVIEW_SIZE=64KiB
# 文件分页接口单行最多返回的前缀字节数；不影响原始文件下载。
RAIN_API_MAX_PREVIEW_LINE_SIZE=8MiB
# 未指定 limit 时，文件和临时结果行接口默认返回的行数。
RAIN_API_DEFAULT_LINE_PAGE_SIZE=5000
# 文件和临时结果行接口单次允许返回的最大行数；默认值不能超过此值。
RAIN_API_MAX_LINE_PAGE_SIZE=10000
# 未指定 size 时，日志搜索接口默认返回的结果数量。
RAIN_API_DEFAULT_SEARCH_RESULTS=50
# 日志搜索接口单次允许返回的最大结果数量；默认值不能超过此值。
RAIN_API_MAX_SEARCH_RESULTS=100

# 临时搜索结果限制
# 单个临时结果的 .log/.meta/.idx 总大小上限。
RAIN_TEMP_RESULT_MAX_SIZE=64MiB
# 临时结果目录的数据库登记总容量上限。
RAIN_TEMP_RESULT_MAX_TOTAL_SIZE=1GiB
# 临时结果最多保留的记录数。
RAIN_TEMP_RESULT_MAX_RECORDS=1000
# 并发物化临时结果的任务数。
RAIN_TEMP_RESULT_CONCURRENT_MATERIALIZATIONS=2

# OpenAI-compatible 模型服务；数据库中的有效管理员配置优先于这些兜底值。
RAIN_AI_BASE_URL=http://127.0.0.1:8000/v1
RAIN_AI_API_KEY=
RAIN_AI_MODEL=
# 单次模型请求超时（秒），范围 1–300。
RAIN_AI_TIMEOUT_SECONDS=120
# 用于加密数据库 API Key 的 32 字节随机主密钥（Base64）。不配置时仍可使用上面的环境变量 Provider，但不能保存 API Key 到数据库。
RAIN_AI_MASTER_KEY=

# First-install administrator. The password has no default and must be set.
RAIN_BOOTSTRAP_ADMIN_USERNAME=admin
RAIN_BOOTSTRAP_ADMIN_PASSWORD=
