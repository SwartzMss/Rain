# Rain 启动配置（业务资源限制请在管理员“系统设置”中维护）
DATABASE_URL=sqlite://./data/rain.db
RAIN_DATA_ROOT=./data/uploads
RAIN_LOG_DIR=./log
SERVER_HOST=0.0.0.0
SERVER_PORT=8078
# 仅本地开发使用；生产环境不要设置为 true。
RESET_DB=false

# 首次安装管理员；已有管理员不会被这些变量重置。
RAIN_BOOTSTRAP_ADMIN_USERNAME=admin
RAIN_BOOTSTRAP_ADMIN_PASSWORD=

# AI 数据库配置的加密根密钥：Base64 编码的 32 字节随机值。
RAIN_AI_MASTER_KEY=

# 以下变量仅为旧版本兼容/高级启动调优保留，不建议放入普通部署环境：
# RAIN_SEARCH_BACKEND=tantivy
# RAIN_INDEXING_MAX_INDEXED_LINE_SIZE=256KiB
# RAIN_AI_BASE_URL=http://127.0.0.1:8000/v1
# RAIN_AI_API_KEY=
# RAIN_AI_MODEL=
# RAIN_AI_TIMEOUT_SECONDS=120
# RAIN_AI_STRUCTURED_OUTPUT=json_object

# 旧业务配置变量（RAIN_ISSUE_MAX_CONTENT_SIZE、RAIN_ALLOW_REGISTRATION 等）
# 只会在对应数据库字段尚未初始化时导入一次；已有数据库值始终优先。
